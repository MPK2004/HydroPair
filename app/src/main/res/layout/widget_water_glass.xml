<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💧 Daily Hydration"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center" />

    <ImageView
        android:id="@+id/widget_glass_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/widget_intake_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 / 2000 ml"
        android:textColor="#F8FAFC"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <Button
        android:id="@+id/widget_btn_log_250"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:text="+250 ml Glass"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0284C7" />
</LinearLayout>
